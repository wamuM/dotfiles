#!/usr/bin/env bash


if [[ -z "$DOTFILES_DIR" ]]; then
    echo "[!] Fatal: DOTFILES_DIR is not set" >&2
    echo "    this usually happens when someone tries to execute 'dotfiles_list' directly" >&2
    echo "    which is not recommended. Instead use 'dotfiles list' which is a wrapper that" >&2
    echo "    sets all required environment variables." >&2
    exit 1
fi
source "$DOTFILES_DIR/dotfiles_lib"

if (( $# == 1 ));then
    if [[ ! -d "$DOTFILES_DIR/$1" ]];then
        msg ! "Module '$1' does not exist!"
        exit 2
    fi
	if [ -t 1 ]; then
		msg + "List of module '$1' reverse dependencies:"
	fi
	for module in "$DOTFILES_DIR"/*;do
		if [ -d "$module" ];then
			check_integrity "$module"
	        	if (( $? != 0 ));then
	            		msg ! "Integrity check failed with error code $1"
	        	fi

        		mapfile -t DEPENDENCIES < <(process "$module/.dependencies") 
            	for dep in "${DEPENDENCIES[@]}"; do
				if [[ "$dep" == "$1" ]];then
					if [ -t 1 ];then
	                    dep_count=$(<"$module/.dep_count")
                        if (( $dep_count > 0 ));then
                    		msg . "- [${GREEN_OUT}ENABLED${OFF_OUT}] ${module##*/}"
                        else
                    		msg . "- [${GREY_OUT}OFF${OFF_OUT}] ${module##*/}"
                        fi
					else
						echo "${module##*/}"
					fi
				fi
            		done
		fi
	done
else
	if [ -t 1 ]; then
		msg + "List of modules:"
	fi
	for module in "$DOTFILES_DIR"/*;do
	    if [ -d "$module" ];then
	        check_integrity "$module"
	        if (( $? != 0 ));then
	            msg ! "Integrity check failed with error code $1"
	        fi
	        dep_count=$(<"$module/.dep_count")
		if [ -t 1 ];then
	        	if [[ -e "$module/.is_not_dep" ]];then
                    if (( $dep_count == 2));then
	        	        msg . "- ${BOLD_OUT}${module##*/}${OFF_OUT}: [${GREEN_OUT}MANUAL${OFF_OUT}] dependency to ${YELLOW_OUT}1${OFF_OUT} active module"
                    else
	        	        msg . "- ${BOLD_OUT}${module##*/}${OFF_OUT}: [${GREEN_OUT}MANUAL${OFF_OUT}] dependency to ${YELLOW_OUT}$((dep_count - 1))${OFF_OUT} active modules"
                    fi
	        	else 
                    if (( $dep_count == 0));then
	        	        msg . "- ${BOLD_OUT}${module##*/}${OFF_OUT}: [${GREY_OUT}OFF${OFF_OUT}] dependency to ${YELLOW_OUT}0${OFF_OUT} active modules"
                    elif (( $dep_count == 1));then
	        	        msg . "- ${BOLD_OUT}${module##*/}${OFF_OUT}: [${YELLOW_OUT}AUTOMATIC${OFF_OUT}] dependency to ${YELLOW_OUT}1${OFF_OUT} active module"
                    else
	        	        msg . "- ${BOLD_OUT}${module##*/}${OFF_OUT}: [${YELLOW_OUT}AUTOMATIC${OFF_OUT}] dependency to ${YELLOW_OUT}$dep_count${OFF_OUT} active modules"
                    fi
	        	fi
		else
	        	if [[ -e "$module/.is_not_dep" ]];then
				echo "${module##*/}"
	        	fi
		fi
	    fi
	done
fi
